PORT=8787
HOST=127.0.0.1
DATABASE_FILE=./data/ad-impressions.sqlite
INGEST_API_TOKEN=replace-with-a-random-local-token
MCP_API_TOKEN=replace-with-a-different-random-local-token
LOG_LEVEL=info

# PostgreSQL (docker-compose.yaml at the repo root). SQLite via
# DATABASE_FILE remains the default; set DATABASE_URL to use Postgres.
DATABASE_URL=postgresql://ad_impressions:ad_impressions@127.0.0.1:5432/ad_impressions
POSTGRES_USER=ad_impressions
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=ad_impressions
POSTGRES_PORT=5432
