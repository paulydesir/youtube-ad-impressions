# Copy this file to .env.development.local for local development.
APP_ENV=development
PORT=8787
HOST=127.0.0.1
# Canonical externally reachable MCP endpoint; must match the OAuth client audience mapping.
MCP_RESOURCE_URL=http://127.0.0.1:8787/mcp
LOG_LEVEL=info

# PostgreSQL (docker-compose.yaml at the repo root).
DATABASE_URL=postgresql://ad_impressions:ad_impressions@127.0.0.1:5432/ad_impressions
POSTGRES_USER=ad_impressions
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=ad_impressions
POSTGRES_PORT=5432

# Local Supabase public key (no service-role key required).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=copy-local-anon-or-publishable-key
