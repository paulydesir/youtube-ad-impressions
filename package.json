{
  "name": "youtube-ad-impressions",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build --workspace @ad-impressions/contracts && npm run dev --workspace @ad-impressions/server",
    "lint": "oxlint --deny-warnings apps packages",
    "lint:fix": "oxlint --fix --deny-warnings apps packages",
    "migrate": "npm run migrate --workspace @ad-impressions/server",
    "test": "npm run test --workspaces --if-present",
    "test:extension": "npm run test --workspace @ad-impressions/extension",
    "build:extension": "npm run build --workspace @ad-impressions/extension",
    "build:extension:prod": "npm run build:prod --workspace @ad-impressions/extension",
    "typecheck:extension": "npm run typecheck --workspace @ad-impressions/extension"
  },
  "devDependencies": {
    "oxlint": "^1.83.0",
    "supabase": "^2.116.0"
  }
}
