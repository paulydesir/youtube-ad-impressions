{
  "name": "youtube-ad-impressions",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:extension": "npm run test --workspace @ad-impressions/extension",
    "build:extension": "npm run build --workspace @ad-impressions/extension",
    "typecheck:extension": "npm run typecheck --workspace @ad-impressions/extension"
  }
}
